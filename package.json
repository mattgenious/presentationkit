{
  "name": "presentationkit",
  "version": "0.1.0",
  "description": "Manifest-driven presentation generation toolkit for evidence-first technical stories.",
  "type": "module",
  "bin": {
    "presentationkit": "./src/cli.js"
  },
  "scripts": {
    "check": "node scripts/examples.js validate",
    "validate:examples": "node scripts/examples.js validate",
    "render:example": "node src/cli.js render-diagrams examples/operational-ai-support.deck.json --out dist/diagrams",
    "render:examples": "node scripts/examples.js render-diagrams",
    "build:example": "node src/cli.js build examples/operational-ai-support.deck.json --out dist/operational-ai-support.pptx",
    "build:examples": "node scripts/examples.js build",
    "smoke": "npm run check && npm run render:examples && npm run build:examples"
  },
  "keywords": [
    "presentation",
    "pptx",
    "storytelling",
    "technical-presentations",
    "evidence"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pptxgenjs": "^4.0.1"
  }
}
